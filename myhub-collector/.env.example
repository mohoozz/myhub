# ============ 登录态（必填）============
# 浏览器登录 bilibili.com 后 F12 → 应用 → Cookie，整段复制（不要只填 SESSDATA，
# 缺少 buvid3 / _uuid 等字段会触发 -352 风控）
BILI_COOKIE=SESSDATA=xxx; bili_jct=xxx; DedeUserID=xxx; buvid3=xxx

# 兜底：上面的值为空时尝试读浏览器 Cookie（Chrome 127+ 常失败，火狐较稳）
BILI_BROWSER=chrome
BILI_PROFILE=

# ============ 目录 ============
# 数据库 / Cookie 缓存 / 报告 / 媒体默认都在 data/
DATA_DIR=data
# 媒体单独放到大容量盘（留空 = data/media）
OUT_DIR=

# ============ 抓取 ============
REQUEST_INTERVAL=1.2
MAX_PAGES=5

# ============ 下载 ============
# direct=直连 / system=跟随系统代理 / http://127.0.0.1:7890=指定代理
PROXY=direct
# best / 1080 / 720 / audio
QUALITY=1080
MAX_DOWNLOADS_PER_RUN=40
MAX_DOWNLOADS_PER_AUTHOR=8
DOWNLOAD_IMAGES=true
KEEP_DAYS=30
