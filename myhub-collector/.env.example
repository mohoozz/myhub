# ============ 登录态 ============
# 三个平台都用弹窗登录，登录成功后自动保存，不需要在这里填 Cookie：
#   python -m app login all        （依次弹窗：B站 → YouTube → 抖音）
#   python -m app login youtube    （单独登录某一个）
# 登录态统一存在 data/credentials/<平台>.txt，过期后重跑上面的命令即可。
# 确认状态：python -m app status
# 登录 + 抖音抓取共用的浏览器通道：chrome / msedge / chromium，留空用 Playwright 自带
BROWSER_CHANNEL=chrome

# ============ 目录 ============
# 数据库 / 登录态默认都在 data/
DATA_DIR=data
# 下载根目录：成品文件平铺存放（平台-作者-标题-发布号-[Pn]），留空 = data/downloads
# 放到大容量盘示例：DOWNLOAD_DIR=D:\Media\Bili
DOWNLOAD_DIR=
# 每日 HTML 报告输出目录，留空 = data/reports
# 想单独存放示例：REPORT_DIR=D:\Media\Reports
REPORT_DIR=

# ============ 抓取 ============
REQUEST_INTERVAL=1.2
MAX_PAGES=5

# ============ YouTube（可选）============
# 登录后自动采集账号的整个订阅列表（读 https://www.youtube.com/feed/channels），无需在这里填频道
# 要额外追加 / 限定频道时取消下面两行注释：
#   YOUTUBE_CHANNELS 支持 UCxxx / @handle / 频道主页链接，逗号或空格分隔
#   YOUTUBE_SUBSCRIPTIONS=false 表示只采上面手填的频道、不碰账号订阅
# YOUTUBE_CHANNELS=UCBR8-60-B28hp2BmDPdntcQ, @MrBeast
# YOUTUBE_SUBSCRIPTIONS=false
# 可选：YouTube 单独走代理（RSS / 视频 CDN），留空跟随 PROXY
YOUTUBE_PROXY=

# ============ 抖音（可选）============
# 首次使用先扫码登录（登录态存进 data/credentials/douyin.txt，这里不用填 Cookie）
#   python -m app login douyin
# 无头运行容易被验证码拦住，默认 false（会弹出浏览器窗口）
DOUYIN_HEADLESS=false
# 关注列表 / 作者主页最多滚动次数（每次约 20 条）
DOUYIN_MAX_SCROLLS=30
# 抖音单独走代理（网页 + 视频 CDN），留空跟随 PROXY
DOUYIN_PROXY=

# ============ 下载 ============
# direct=直连 / system=跟随系统代理 / http://127.0.0.1:7890=指定代理
PROXY=direct
# best / 1080 / 720 / audio
QUALITY=1080
DOWNLOAD_IMAGES=true
# 单条视频最长时长（分钟），0 = 不限制。B 站多分 P 按总时长算，超长的只标「跳过」不下载
MAX_DURATION_MINUTES=0
KEEP_DAYS=30
# 下载完成后把文件修改时间设为内容发布时间（资源管理器按「修改日期」排序即发布顺序）
FILE_MTIME_FROM_PUBLISH=true
# ffmpeg 所在目录（未加入 PATH 时填这里，例如 C:\Code\ffmpeg-master-latest-win64-gpl-shared\bin）
FFMPEG_LOCATION=
