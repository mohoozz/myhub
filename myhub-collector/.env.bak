# myhub-collector 配置（Web 门户生成；也可以手工编辑，保存时会重新排版）
# 登录态不在这里：跑 `python -m app login` 或用门户的「平台登录」页。

# ---------- 浏览器 ----------
# 三个平台的登录和抖音抓取都走浏览器，一般保持默认即可。
# chrome / msedge / chromium；留空用 Playwright 自带 Chromium
BROWSER_CHANNEL=chrome

# ---------- 目录 ----------
# 数据目录 / 下载目录改动后需要重启服务；报告目录即时生效。
# 数据库、登录态都放这里，默认 data
DATA_DIR=data
# 成品文件平铺存放，留空 = <数据目录>/downloads
DOWNLOAD_DIR=E:\mohoo\___\__Watchlater
# 每日 HTML 报告输出位置，留空 = <数据目录>/reports
REPORT_DIR=E:\mohoo\___\__Watchlater

# ---------- 抓取 ----------
# 相邻请求 / 相邻作者的间隔，调大更防风控
REQUEST_INTERVAL=10.0
# 单个作者最多翻几页动态，默认 5
MAX_PAGES=5

# ---------- YouTube ----------
# 登录后默认自动采集账号整个订阅列表，这里通常不用填。
# UCxxx / @handle / 频道主页链接，逗号或空格分隔；留空只用账号订阅
YOUTUBE_CHANNELS=
# 关掉后只采集上面手填的频道
YOUTUBE_SUBSCRIPTIONS=true
# 留空跟随 PROXY
YOUTUBE_PROXY=

# ---------- 抖音 ----------
# 无头更容易撞验证码，建议保持关闭
DOUYIN_HEADLESS=false
# 关注列表 / 作者主页，每次约 20 条
DOUYIN_MAX_SCROLLS=30
# 留空跟随 PROXY
DOUYIN_PROXY=
# 填浏览器 User Data 目录可直接继承登录态；留空用独立 profile
DOUYIN_USER_DATA_DIR=
# Default / Profile 1；留空跟随浏览器上次使用
DOUYIN_PROFILE_NAME=

# ---------- 下载 ----------
# direct=直连 / system=跟随系统代理 / http://127.0.0.1:7890
PROXY=direct
QUALITY=1080
DOWNLOAD_IMAGES=true
# 0 = 不限制；B 站多分 P 按总时长算，超长的只记「跳过」不下载
MAX_DURATION_MINUTES=90
# python -m app clean 使用
KEEP_DAYS=30
# 下载完成后把修改时间设为发布时间，资源管理器即可按发布顺序排序
FILE_MTIME_FROM_PUBLISH=true
# 未加入 PATH 时填这里，留空只从 PATH 找
FFMPEG_LOCATION=
