{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{MYHUB_QT_DIR};$env{MYHUB_VCPKG_INSTALLED};${sourceDir}/third_party/mpvqt-install",
        "Qt6_DIR": "$env{MYHUB_QT_DIR}/lib/cmake/Qt6",
        "Libsmb2_ROOT": "$env{MYHUB_VCPKG_INSTALLED}"
      },
      "environment": {
        "MYHUB_QT_DIR": "C:/Qt/6.8.3/msvc2022_64",
        "MYHUB_VCPKG_INSTALLED": "C:/vcpkg/installed/x64-windows"
      },
      "vendor": {
        "comment": "MSVC 环境需先由 vcvars64.bat 导入；见 README「构建」一节或使用 scripts/build.ps1"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (MSVC + Ninja)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release (MSVC + Ninja)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{MYHUB_QT_DIR};$env{MYHUB_VCPKG_INSTALLED};${sourceDir}/third_party/mpvqt-install",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
      },
      "environment": {
        "MYHUB_QT_DIR": "$env{HOME}/Qt/6.8.3/macos",
        "MYHUB_VCPKG_INSTALLED": "$env{HOME}/vcpkg/installed/arm64-osx"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug (Clang + Ninja)",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release (universal binary)",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
